<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="list">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="category" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="style" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="activateCost" minOccurs="0" maxOccurs="1">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="item" minOccurs="0" maxOccurs="unbounded">
														<xs:complexType>
															<xs:attribute name="id" type="xs:unsignedInt" use="required" />
															<xs:attribute name="count" type="xs:unsignedByte" use="optional" />
														</xs:complexType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="deactivateCost" minOccurs="0" maxOccurs="1">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="item" minOccurs="0" maxOccurs="unbounded">
														<xs:complexType>
															<xs:attribute name="id" type="xs:unsignedInt" use="required" />
															<xs:attribute name="count" type="xs:unsignedByte" use="optional" />
														</xs:complexType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="cost" minOccurs="0" maxOccurs="1">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="item" minOccurs="0" maxOccurs="unbounded">
														<xs:complexType>
															<xs:attribute name="id" type="xs:unsignedInt" use="required" />
															<xs:attribute name="count" type="xs:unsignedByte" use="optional" />
														</xs:complexType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="activatableItems" minOccurs="0" maxOccurs="1">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="item" maxOccurs="unbounded">
														<xs:complexType>
															<xs:attribute name="raceId" type="xs:unsignedByte" use="required" />
															<xs:attribute name="sexId" type="xs:unsignedByte" use="required" />
															<xs:attribute name="classId" type="xs:unsignedByte" use="required" />
														</xs:complexType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
									<xs:attribute name="styleId" type="xs:unsignedByte" use="required" />
									<xs:attribute name="name" type="xs:string" use="required" />
									<xs:attribute name="shiftWeaponId" type="xs:unsignedInt" use="optional" />
									<xs:attribute name="skillId" type="xs:unsignedInt" use="optional" />
									<xs:attribute name="skillLevel" type="xs:unsignedInt" use="optional" />
									<xs:attribute name="weaponType" use="optional">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="DAGGER" />
												<xs:enumeration value="SWORD" />
												<xs:enumeration value="BLUNT" />
												<xs:enumeration value="DUALFIST" />
												<xs:enumeration value="POLE" />
												<xs:enumeration value="BOW" />
												<xs:enumeration value="DUAL" />
												<xs:enumeration value="PISTOLS" />
												<xs:enumeration value="RAPIER" />
												<xs:enumeration value="ANCIENTSWORD" />
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
						<xs:attribute name="id" type="xs:unsignedByte" use="required" />
						<xs:attribute name="type" type="xs:string" use="required" />
						<xs:attribute name="swapCostId" type="xs:unsignedInt" use="optional" />
						<xs:attribute name="swapCostCount" type="xs:unsignedByte" use="optional" />
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>