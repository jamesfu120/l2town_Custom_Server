<?xml version="1.0" encoding="UTF-8"?>
<list xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xsd/cubics.xsd">
	<!--
		C1 Vampiric Cubic configuration.
		This cubic periodically drains HP from the owner's valid hostile target.
		Changing power modifies the drain skill damage baseline used by the cubic runtime.
		
		Attribute guide:
		duration is the cubic lifetime in seconds.
		delay is the interval in seconds between cubic action checks.
		maxCount is the maximum number of successful cubic actions before the cubic stops or is consumed.
		useUp controls whether the cubic is removed after reaching maxCount when supported by the core.
		power is the cubic base magic attack value used by offensive formulas.
		selectionMode controls how skills are selected when more than one skill is configured.
		targetType controls whether the cubic selects hostile targets or uses specialized targeting such as HEAL.
	-->
	<cubic id="2" level="1" slot="2" duration="900" delay="15" maxCount="20" useUp="1" power="351.0" selectionMode="RANDOM" targetType="TARGET">
		<skills>
			<skill id="4050" level="1" /> <!-- Cubic Drain -->
		</skills>
	</cubic>
