<?xml version="1.0" encoding="UTF-8"?>
<list xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../xsd/skills.xsd">
	<!--
		Residual armor-set skills.
		All numeric set bonuses (P. Def., HP, M. Atk., etc.) are stored inline in dist/game/data/stats/armorsets/*.xml as <add>/<mul> elements following the retail format.
		Only DefenceTrait effects remain here, since traits are not part of the simple Stat add/mul model.
		The visible passive icon for any equipped set is the canonical retail skill 3006 (Equip Set Items) in skills/03000-03099.xml.
	-->
	<skill id="3502" levels="1" name="Mithril Heavy Armor Set">
		<!-- Increases resistance to poison attack. -->
		<icon>icon.skill0231</icon>
		<operateType>P</operateType>
		<displayId>3006</displayId>
		<targetType>SELF</targetType>
		<magicLevel>1</magicLevel>
		<effects>
			<effect name="DefenceTrait">
				<POISON>20</POISON>
			</effect>
		</effects>
	</skill>
	<skill id="3509" levels="1" name="Chain Mail Set">
		<!-- Increases resistance to dagger attack. -->
		<icon>icon.skill0231</icon>
		<operateType>P</operateType>
		<displayId>3006</displayId>
		<targetType>SELF</targetType>
		<magicLevel>1</magicLevel>
		<effects>
			<effect name="DefenceTrait">
				<DAGGER>6</DAGGER>
				<DUALDAGGER>6</DUALDAGGER>
			</effect>
		</effects>
	</skill>
	<skill id="3527" levels="1" name="Doom Light Armor Set">
		<!-- Increases resistance to poison attack. -->
		<icon>icon.skill0233</icon>
		<operateType>P</operateType>
		<displayId>3006</displayId>
		<targetType>SELF</targetType>
		<magicLevel>1</magicLevel>
		<effects>
			<effect name="DefenceTrait">
				<POISON>20</POISON>
			</effect>
		</effects>
	</skill>
</list>