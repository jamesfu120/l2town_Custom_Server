<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="list">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="relicSummonCategoryData">
					<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" name="summonCategory">
								<xs:complexType>
									<xs:attribute name="id" type="xs:unsignedByte" use="required" />
									<xs:attribute name="priceId" type="xs:unsignedInt" use="required" />
									<xs:attribute name="amount" type="xs:unsignedInt" use="required" />
									<xs:attribute name="summonCount" type="xs:unsignedByte" use="required" />
									<xs:attribute name="active" type="xs:boolean" use="required" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="relicEnchantData">
					<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" name="enchantFee">
								<xs:complexType>
									<xs:attribute name="grade" use="required">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="NOGRADE" />
												<xs:enumeration value="DGRADE" />
												<xs:enumeration value="CGRADE" />
												<xs:enumeration value="BGRADE" />
												<xs:enumeration value="AGRADE" />
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="feeItemId" type="xs:unsignedByte" use="required" />
									<xs:attribute name="feeCount" type="xs:unsignedInt" use="required" />
								</xs:complexType>
							</xs:element>
							<xs:element name="enchantData">
								<xs:complexType>
									<xs:attribute name="chancePerIngredients" type="xs:string" use="required" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="relicCombineData">
					<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" name="combineCategory">
								<xs:complexType>
									<xs:attribute name="grade" use="required">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="NOGRADE" />
												<xs:enumeration value="DGRADE" />
												<xs:enumeration value="CGRADE" />
												<xs:enumeration value="BGRADE" />
												<xs:enumeration value="AGRADE" />
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="feeItemId" type="xs:unsignedInt" use="required" />
									<xs:attribute name="feeCount" type="xs:unsignedInt" use="required" />
								</xs:complexType>
							</xs:element>
							<xs:element maxOccurs="unbounded" name="combineData">
								<xs:complexType>
									<xs:attribute name="chancePerGrade" use="required">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="NOGRADE" />
												<xs:enumeration value="DGRADE" />
												<xs:enumeration value="CGRADE" />
												<xs:enumeration value="BGRADE" />
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="failCommonChance" type="xs:decimal" use="optional" />
									<xs:attribute name="failShiningChance" type="xs:decimal" use="optional" />
									<xs:attribute name="successCommonChance" type="xs:decimal" use="optional" />
									<xs:attribute name="successShiningChance" type="xs:decimal" use="optional" />
								</xs:complexType>
							</xs:element>
							<xs:element name="guaranteedCompound">
								<xs:complexType>
									<xs:attribute name="maxPoints" type="xs:unsignedByte" use="required" />
									<xs:attribute name="pointsPerAttempt" type="xs:unsignedInt" use="required" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="relicReplaceData">
					<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" name="replaceCategory">
								<xs:complexType>
									<xs:attribute name="grade" use="required">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="BGRADE" />
												<xs:enumeration value="AGRADE" />
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="replaceAttempts" type="xs:unsignedByte" use="required" />
									<xs:attribute name="feeItemId" type="xs:unsignedInt" use="required" />
									<xs:attribute name="feeCountList" type="xs:string" use="required" />
								</xs:complexType>
							</xs:element>
							<xs:element maxOccurs="unbounded" name="replaceData">
								<xs:complexType>
									<xs:attribute name="chancePerGrade" use="required">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="BGRADE" />
												<xs:enumeration value="AGRADE" />
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="failChance" type="xs:decimal" use="optional" />
									<xs:attribute name="successCommonChance" type="xs:decimal" use="optional" />
									<xs:attribute name="successShiningChance" type="xs:decimal" use="optional" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element maxOccurs="unbounded" name="relic">
					<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" name="relicStat">
								<xs:complexType>
									<xs:attribute name="enchantLevel" type="xs:unsignedShort" use="required" />
									<xs:attribute name="skillId" type="xs:unsignedInt" use="required" />
									<xs:attribute name="skillLevel" type="xs:unsignedShort" use="required" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
						<xs:attribute name="id" type="xs:unsignedInt" use="required" />
						<xs:attribute name="name" type="xs:string" use="optional" />
						<xs:attribute name="grade" type="xs:string" use="required" />
						<xs:attribute name="type" use="required">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="COMMON" />
									<xs:enumeration value="SHINING" />
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
						<xs:attribute name="summonChance" type="xs:unsignedLong" use="required" />
						<xs:attribute name="baseRelicId" type="xs:unsignedInt" use="required" />
						<xs:attribute name="compoundChanceModifier" type="xs:decimal" use="required" />
						<xs:attribute name="compoundUpGradeChanceModifier" type="xs:decimal" use="required" />
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>