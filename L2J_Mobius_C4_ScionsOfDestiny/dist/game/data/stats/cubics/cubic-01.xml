	<!-- Storm Cubic: offensive cubic that casts Cubic DD against the owner valid enemy target. -->
	<!-- duration is in seconds; delay is the interval between cubic action checks. -->
	<!-- maxCount limits successful cubic activations; useUp=1 removes the cubic after maxCount is reached. -->
