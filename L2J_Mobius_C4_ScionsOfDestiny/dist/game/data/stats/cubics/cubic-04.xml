<?xml version="1.0" encoding="UTF-8"?>
<list xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xsd/cubics.xsd">
	<!-- Viper Cubic: offensive cubic that applies poison damage over time to a valid enemy target. -->
	<!-- duration is in seconds; delay is the interval between cubic action checks. -->
	<!-- maxCount limits successful cubic activations; useUp=1 removes the cubic after maxCount is reached. -->
	<!-- selectionMode controls skill selection; targetType controls target routing used by CubicAction. -->
	<cubic id="4" level="1" slot="4" duration="900" delay="20" maxCount="15" useUp="0" power="531.0" selectionMode="RANDOM" targetType="TARGET">
